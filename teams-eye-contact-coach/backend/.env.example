# Copy to .env for local development; never commit .env. In Azure, set these as App Service
# application settings (DATABASE_URL as a Key Vault reference).

# Entra tenant the API accepts tokens from (single tenant; the issuer is pinned to it).
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# Client ID of the API's own app registration (the token audience). Expose a delegated scope
# named Sessions.ReadWrite on it, and add that scope to the desktop and dashboard registrations.
API_CLIENT_ID=00000000-0000-0000-0000-000000000000
REQUIRED_SCOPE=Sessions.ReadWrite

# Azure Database for PostgreSQL connection string (a secret: use Key Vault in Azure).
DATABASE_URL=postgres://user:password@your-server.postgres.database.azure.com:5432/coach
DATABASE_SSL=true

# Bind address: loopback in development; in Azure, the specific internal address of the instance.
# All-interface addresses (0.0.0.0, ::) are rejected at startup.
HOST=127.0.0.1
PORT=3000

# Comma-separated exact origins allowed by CORS (the dashboard), e.g. https://dash.example.com
CORS_ORIGINS=
# Set true only behind a trusted reverse proxy (App Service) so client IPs are read correctly.
TRUST_PROXY=false
LOG_LEVEL=info
