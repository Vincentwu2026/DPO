{
  "name": "teams-eye-contact-coach",
  "version": "0.1.0",
  "private": true,
  "description": "Teams Eye Contact Coach monorepo",
  "workspaces": [
    "electron",
    "azure-function",
    "backend",
    "dashboard"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n electron,python -c blue,green \"npm run dev --workspace electron\" \"npm run dev:python\"",
    "dev:python": "node scripts/run-python.mjs python/main.py",
    "fetch:model": "node scripts/fetch-model.mjs",
    "build:tracker": "node scripts/build-tracker.mjs",
    "test:py": "node scripts/run-python.mjs -m pytest python",
    "build": "npm run build --workspace electron",
    "lint": "npm run lint:js && npm run lint:py",
    "lint:js": "eslint .",
    "lint:py": "node scripts/run-python.mjs -m ruff check python && node scripts/run-python.mjs -m black --check python",
    "format": "prettier --write . && node scripts/run-python.mjs -m black python",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
