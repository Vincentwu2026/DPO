# Copy to .env.local for local development. These values are bundled into the public SPA, so they
# must never be secrets: a client ID, tenant ID, scope name and URL are all fine; a client secret
# is not (the dashboard is a public client and uses the authorization-code flow with PKCE).

# Entra tenant (single tenant).
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# Client ID of the dashboard's own SPA app registration. Its redirect URI must be exactly the
# origin the dashboard is served from, as a "Single-page application" platform entry
# (http://127.0.0.1:5173 for local development).
VITE_DASHBOARD_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Delegated scope exposed by the API registration (same value the desktop app uses).
VITE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/Sessions.ReadWrite
# Base URL of the backend API: https, or http for localhost only.
VITE_API_BASE_URL=https://your-dashboard-api.azurewebsites.net
