# Copy to .env (never commit .env) and fill in values from your Entra ID app registration.
# Delegated Graph permissions required: OnlineMeetings.Read, Presence.Read, CallRecords.Read.All
# Redirect URI: http://localhost (Mobile and desktop applications platform; loopback flow)
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Base URL of the Azure Function app (used for /api/connect-info and Graph notificationUrl).
# Graph notifications require a public HTTPS URL.
FUNCTION_BASE_URL=https://your-function-app.azurewebsites.net

# Shared secret echoed back by Graph in every notification; must match GRAPH_CLIENT_STATE in the
# Azure Function's app settings. Generate with: openssl rand -base64 32
GRAPH_CLIENT_STATE=replace-with-random-secret

# Cloud dashboard sync (optional; leave unset to keep sessions on this device only).
# API_BASE_URL must be https (http is allowed for localhost only). API_SCOPE is the delegated
# scope exposed by the backend's own Entra app registration.
API_BASE_URL=https://your-dashboard-api.azurewebsites.net
API_SCOPE=api://00000000-0000-0000-0000-000000000000/Sessions.ReadWrite
