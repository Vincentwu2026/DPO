{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "composite": true,
    "paths": { "@renderer/*": ["./src/renderer/src/*"] }
  },
  "include": [
    "src/renderer/src/**/*",
    "src/renderer/settings/**/*",
    "src/renderer/hud/**/*",
    "src/renderer/report/**/*",
    "src/renderer/calibration/**/*",
    "src/shared/**/*",
    "src/main/tracker/protocol.ts",
    "src/main/tracker/thresholds.ts",
    "src/preload/index.d.ts"
  ]
}
